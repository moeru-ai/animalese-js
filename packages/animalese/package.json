{
  "name": "animalese",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Animal Crossing style speech for the browser: text in, babble out",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@animalese/core": "workspace:^",
    "@animalese/g2p": "workspace:^",
    "@animalese/web": "workspace:^"
  }
}
