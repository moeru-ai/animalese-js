{
  "name": "animalese-js",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:packages": "pnpm run build",
    "dev": "pnpm -F @animalese/playground dev",
    "bake": "node packages/bake/src/cli.ts bake",
    "say": "node packages/bake/src/cli.ts say",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "moeru-lint .",
    "lint:fix": "moeru-lint --fix .",
    "docs:toc": "doctoc --github --title \"## Table of Contents\" --maxlevel=2 README.md"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@moeru/eslint-config": "^0.1.0-beta.20",
    "@types/node": "^26.6.4",
    "doctoc": "^2.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-slop": "0.1.3",
    "jiti": "^2.7.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.3"
  }
}
